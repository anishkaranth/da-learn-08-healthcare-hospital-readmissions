{
 "datasets": [
  {
   "name": "kpi",
   "displayName": "Headline KPIs",
   "queryLines": [
    "SELECT encounters_total, patients_total, readmit_30d_pct / 100 AS readmit_30d_rate, readmit_any_pct / 100 AS readmit_any_rate, avg_los_days FROM workspace.da_learn_08.a_kpi_headline"
   ]
  },
  {
   "name": "age",
   "displayName": "By age",
   "queryLines": [
    "SELECT age_group, age_mid, encounters, readmit_30d_pct FROM workspace.da_learn_08.a_readmit_by_age ORDER BY age_mid"
   ]
  },
  {
   "name": "diag",
   "displayName": "By diagnosis",
   "queryLines": [
    "SELECT primary_diagnosis_group, encounters, readmit_30d_pct FROM workspace.da_learn_08.a_readmit_by_diagnosis ORDER BY readmit_30d_pct DESC"
   ]
  },
  {
   "name": "los",
   "displayName": "By length of stay",
   "queryLines": [
    "SELECT los_days, encounters, readmit_30d_pct FROM workspace.da_learn_08.a_readmit_by_los ORDER BY los_days"
   ]
  },
  {
   "name": "med",
   "displayName": "By medication",
   "queryLines": [
    "SELECT medication, encounters_prescribed, readmit_30d_pct FROM workspace.da_learn_08.a_readmit_by_medication ORDER BY readmit_30d_pct DESC"
   ]
  },
  {
   "name": "prior",
   "displayName": "By prior inpatient visits",
   "queryLines": [
    "SELECT prior_inpatient_band, encounters, readmit_30d_pct FROM workspace.da_learn_08.a_readmit_by_prior_inpatient ORDER BY prior_inpatient_band"
   ]
  },
  {
   "name": "disch",
   "displayName": "By discharge destination",
   "queryLines": [
    "SELECT discharge_group, encounters, readmit_30d_pct FROM workspace.da_learn_08.a_readmit_by_discharge ORDER BY readmit_30d_pct DESC"
   ]
  }
 ],
 "pages": [
  {
   "name": "overview",
   "displayName": "Overview",
   "layout": [
    {
     "widget": {
      "name": "t1",
      "multilineTextboxSpec": {
       "lines": [
        "## Diabetes 130-US hospitals: 30-day readmissions (full data, 101,763 encounters)"
       ]
      }
     },
     "position": {
      "x": 0,
      "y": 0,
      "width": 6,
      "height": 1
     }
    },
    {
     "widget": {
      "name": "k_enc",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "kpi",
         "fields": [
          {
           "name": "encounters_total",
           "expression": "`encounters_total`"
          }
         ],
         "disaggregated": true
        }
       }
      ],
      "spec": {
       "version": 2,
       "widgetType": "counter",
       "encodings": {
        "value": {
         "fieldName": "encounters_total",
         "displayName": "Encounters",
         "format": {
          "type": "number",
          "abbreviation": "compact",
          "decimalPlaces": {
           "type": "max",
           "places": 1
          }
         }
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Encounters"
       }
      }
     },
     "position": {
      "x": 0,
      "y": 1,
      "width": 2,
      "height": 2
     }
    },
    {
